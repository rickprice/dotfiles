[global]
    monitor = 0
    follow = mouse
    geometry = "768x5-48+48"
    indicate_hidden = yes
    shrink = no
    transparency = 0
    notification_height = 0
    separator_height = 24
    padding = 18
    horizontal_padding = 18
    frame_width = 3
    frame_color = "#66D9EF"
    separator_color = frame
    sort = yes
    idle_threshold = 120
    font = Dejavu Sans 36
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    icon_position = left
    max_icon_size = 144
    icon_path = /usr/share/icons/gnome/16x16/status/:/usr/share/icons/gnome/16x16/devices/
    sticky_history = yes
    history_length = 100
    dmenu = /usr/bin/dmenu -p dunst:
    browser = /usr/bin/firefox -new-tab
    always_run_script = true
    title = Dunst
    class = Dunst
    startup_notification = false
    verbosity = mesg
    corner_radius = 0
    ignore_dbusclose = false
    force_xinerama = false
    mouse_left_click = close_current
    mouse_middle_click = do_action
    mouse_right_click = close_all

[experimental]
    per_monitor_dpi = false

[shortcuts]
    close = ctrl+space
    close_all = ctrl+shift+space
    history = ctrl+grave
    context = ctrl+shift+period

[urgency_low]
    background = "#1D1F21"
    foreground = "#f8f8f2"
    frame_color = "#403D3D"
    timeout = 10

[urgency_normal]
    background = "#1D1F21"
    foreground = "#f8f8f2"
    frame_color = "#66D9EF"
    timeout = 10

[urgency_critical]
    background = "#1D1F21"
    foreground = "#f8f8f2"
    frame_color = "#661512"
    timeout = 0