[global]
    monitor = 0
    follow = mouse
    width = 768
    height = 300
    origin = top-right
    offset = 0x48
    scale = 0
    notification_limit = 10
    progress_bar = true
    progress_bar_height = 24
    progress_bar_frame_width = 0
    progress_bar_min_width = 705
    progress_bar_max_width = 705
    indicate_hidden = yes
    transparency = 0
    separator_height = 24
    padding = 18
    horizontal_padding = 18
    text_icon_padding = 24
    frame_width = 3
    frame_color = "#66D9EF"
    gap_size = 24
    separator_color = frame
    sort = yes
    idle_threshold = 0
    font = DejaVu Sans 36
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    enable_recursive = false
    icon_position = left
    min_icon_size = 144
    max_icon_size = 144
    icon_path = /usr/share/icons/gnome/16x16/status/:/usr/share/icons/gnome/16x16/devices/
    sticky_history = yes
    history_length = 100
    dmenu = /usr/bin/dmenu -p dunst:
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    corner_radius = 0
    ignore_dbusclose = false
    force_xwayland = false
    force_xinerama = false
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[experimental]
    per_monitor_dpi = false

[urgency_low]
    background = "#1D1F21"
    foreground = "#f8f8f2"
    frame_color = "#403D3D"
    timeout = 10

[urgency_normal]
    background = "#1D1F21"
    foreground = "#f8f8f2"
    frame_color = "#66D9EF"
    timeout = 10

[urgency_critical]
    background = "#1D1F21"
    foreground = "#f8f8f2"
    frame_color = "#661512"
    timeout = 0